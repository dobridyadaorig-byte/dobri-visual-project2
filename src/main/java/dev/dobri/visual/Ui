package dev.dobri.visual;

import net.minecraft.client.gui.DrawContext;

/** Общие цвета и мелкие помощники для рисования. Все цвета с альфой (0xFF......). */
public final class Ui {
    public static final int BG_DIM = 0x99000000;
    public static final int PANEL_BORDER = 0xFF2E2E36;
    public static final int PANEL_BG = 0xFF141417;
    public static final int ROW_BG = 0xFF1C1C21;
    public static final int ROW_HOVER = 0xFF25252C;
    public static final int PURPLE = 0xFF8B5CF6;
    public static final int PURPLE_DARK = 0xFF5B3BB0;
    public static final int TRACK_OFF = 0xFF3A3A44;
    public static final int TEXT = 0xFFE6E6EA;
    public static final int TEXT_DIM = 0xFF8E8E99;

    private Ui() {}

    /** Прямоугольник со слегка скруглёнными углами. */
    public static void roundRect(DrawContext c, int x, int y, int w, int h, int color) {
        c.fill(x + 2, y, x + w - 2, y + h, color);
        c.fill(x + 1, y + 1, x + w - 1, y + h - 1, color);
        c.fill(x, y + 2, x + w, y + h - 2, color);
    }

    public static int lerpColor(int a, int b, float t) {
        int aa = (a >>> 24) & 255, ar = (a >> 16) & 255, ag = (a >> 8) & 255, ab = a & 255;
        int ba = (b >>> 24) & 255, br = (b >> 16) & 255, bg = (b >> 8) & 255, bb = b & 255;
        int ra = (int) (aa + (ba - aa) * t);
        int rr = (int) (ar + (br - ar) * t);
        int rg = (int) (ag + (bg - ag) * t);
        int rb = (int) (ab + (bb - ab) * t);
        return (ra << 24) | (rr << 16) | (rg << 8) | rb;
    }
}
